# Copy to quiva-workspaces-mcp/.env and fill in ONE of the auth options below.
# The .env file is gitignored — never commit real credentials.
#
# Auth reality: the core space/task/comment CRUD works with an API key alone,
# but attribution fields (space owner, task created_by, comment author) are
# only set when a Bearer JWT is present, and comment reactions need the JWT to
# key the reacting user. Prefer the bearer token or email/password options.

# API environment (default: staging)
QUIVA_API_URL=https://api.microstrate.io
# Production: https://api.quiva.ai

# --- Option 1: API key (drives core CRUD; no user attribution) ---
QUIVA_API_KEY=

# --- Option 2: bearer token (JWT) ---
QUIVA_BEARER_TOKEN=

# --- Option 3: email + password (auto-login with refresh) ---
QUIVA_EMAIL=
QUIVA_PASSWORD=
QUIVA_ACCOUNT=

# Optional: path to a Node >= 18 binary if auto-detection fails
QUIVA_NODE=
