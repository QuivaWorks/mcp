# Copy to quiva-coworker-mcp/.env and fill in ONE of the auth options below.
# The .env file is gitignored. Never commit real credentials.
#
# An API key works: the gateway swaps it for a token carrying the key's user
# and role. A restricted (msr-) key must allow /hub/coworker* and
# /hub/agent/model-pool. Admin-only writes need an admin or root user.

# API environment (default: https://api.quiva.ai)
QUIVA_API_URL=https://api.quiva.ai

# --- Option 1: API key ---
QUIVA_API_KEY=

# --- Option 2: bearer token (JWT) ---
QUIVA_BEARER_TOKEN=

# --- Option 3: email + password (auto-login with refresh) ---
QUIVA_EMAIL=
QUIVA_PASSWORD=
QUIVA_ACCOUNT=

# Optional: path to a Node >= 18 binary if auto-detection fails
QUIVA_NODE=
