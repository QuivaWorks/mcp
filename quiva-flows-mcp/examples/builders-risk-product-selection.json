                      },
                      {
                        "input": [
                          "@fact:CIP_BR_CompValueLimit.value",
                          10000000
                        ],
                        "operator": ">"
                      }
                    ],
                    "operator": "and"
                  },
                  "outcome": "Product2"
                },
                {
