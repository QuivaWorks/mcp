        "data": {
          "id": "zl6q42Zr0X3QXjpv0Wv4K",
          "node_type": "condition",
          "payload": [
            {
              "condition": {
                "input": [
                  "$.CHECK_FOR_DUPLICATES.duplicate_exists",
