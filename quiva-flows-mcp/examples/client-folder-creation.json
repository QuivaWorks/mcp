      {
        "data": {
          "id": "CHECK_FOR_DUPLICATES",
          "name": "Check for duplicates",
          "node_type": "eval",
          "payload": {
            "code": "(function() {\n  // foldersList is already the results array from DEDUPE_CHECK\n  var duplicateFolder = null;\n  \n  for (var i = 0; i < foldersList.length; i++) {\n    // Parse folder name from: spaces.FAHUB.{folderName}.metadata.json\n    var nameParts = foldersList[i].name.split('.');\n    var folderName = nameParts[2];\n    \n    if (folderName === uniqueName) {\n      duplicateFolder = {\n        \"name\": foldersList[i].name,\n        \"folderName\": folderName,\n        \"subject\": foldersList[i].subject,\n        \"modified\": foldersList[i].modified\n      };\n      break;\n    }\n  }\n  \n  return {\n    \"duplicate_exists\": duplicateFolder ? true : false,\n    \"matching_folder\": duplicateFolder || null\n  };\n})();",
            "params": {
              "foldersList": "$.DEDUPE_CHECK.data.results",
              "uniqueName": "$.trigger.firstName| |$.trigger.lastName"
            }
          }
        },
        "id": "CHECK_FOR_DUPLICATES",
        "position": {
          "x": 555.4687744027196,
          "y": -1.2864675948760862
        },
        "type": "custom",
        "measured": {
          "height": 96,
