# Copy to quiva-flows-mcp/.env and fill in ONE of the auth options below.
# The .env file is gitignored — never commit real credentials.

# API environment (default: staging)
QUIVA_API_URL=https://api.microstrate.io
# Production: https://api.quiva.ai

# --- Option 1: API key ---
QUIVA_API_KEY=

# --- Option 2: bearer token (JWT) ---
QUIVA_BEARER_TOKEN=

# --- Option 3: email + password (auto-login with refresh) ---
QUIVA_EMAIL=
QUIVA_PASSWORD=
QUIVA_ACCOUNT=

# Optional: path to a Node >= 18 binary if auto-detection fails
QUIVA_NODE=
