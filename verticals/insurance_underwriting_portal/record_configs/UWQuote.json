{
  "id": "UWQuote",
  "name": "Builders Risk Quote",
  "description": "A Builders Risk quotation: applicant, project, coverage and risk detail, plus the pricing written back by the quote-pricing flow.",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "quote_reference": {
        "type": "string",
        "title": "Quote reference"
      },
      "status": {
        "type": "string",
        "title": "Status",
        "enum": [
          "Draft",
          "Submitted",
          "Priced",
          "Accepted",
          "Declined",
          "Expired"
        ],
        "default": "Draft"
      },
      "client_id": {
        "type": "string",
        "title": "Applicant record id"
      },
      "underwriter_id": {
        "type": "string",
        "title": "Underwriter (user id)"
      },
      "quote_date": {
        "type": "string",
        "title": "Quote date",
        "format": "date"
      },
      "validity_days": {
        "type": "integer",
        "title": "Valid for (days)",
        "minimum": 1,
        "default": 30
      },
      "insured_name": {
        "type": "string",
        "title": "Insured / builder name"
      },
      "insured_license": {
        "type": "string",
        "title": "Licence number"
      },
      "insured_address": {
        "type": "string",
        "title": "Business address"
      },
      "insured_contact": {
        "type": "string",
        "title": "Contact person"
      },
      "insured_phone": {
        "type": "string",
        "title": "Contact phone"
      },
      "insured_email": {
        "type": "string",
        "title": "Contact email",
        "format": "email"
      },
      "insured_years_in_business": {
        "type": "integer",
        "title": "Years in business",
        "minimum": 0
      },
      "prior_loss_history": {
        "type": "boolean",
        "title": "Prior losses?"
      },
      "prior_loss_details": {
        "type": "string",
        "title": "Prior loss details"
      },
      "project_name": {
        "type": "string",
        "title": "Project name"
      },
      "project_type": {
        "type": "string",
        "title": "Project type",
        "enum": [
          "New Construction",
          "Renovation",
          "Demolition"
        ]
      },
      "project_address": {
        "type": "string",
        "title": "Project address"
      },
      "renovation_scope": {
        "type": "string",
        "title": "Renovation scope"
      },
      "demolition_permit": {
        "type": "string",
        "title": "Demolition permit reference"
      },
      "start_date": {
        "type": "string",
        "title": "Estimated start",
        "format": "date"
      },
      "completion_date": {
        "type": "string",
        "title": "Estimated completion",
        "format": "date"
      },
      "construction_type": {
        "type": "string",
        "title": "Construction type",
        "enum": [
          "Wood Frame",
          "Masonry/Concrete",
          "Steel Frame"
        ]
      },
      "location_zone": {
        "type": "string",
        "title": "Location risk zone",
        "enum": [
          "Urban High Risk",
          "Urban Standard",
          "Suburban",
          "Rural"
        ]
      },
      "square_footage": {
        "type": "number",
        "title": "Square footage",
        "minimum": 0
      },
      "stories": {
        "type": "integer",
        "title": "Number of stories",
        "minimum": 1
      },
      "contract_value": {
        "type": "number",
        "title": "Estimated contract value",
        "minimum": 0
      },
      "tiv": {
        "type": "number",
        "title": "Total Insurable Value (TIV)",
        "minimum": 0
      },
      "coverage_limits": {
        "type": "number",
        "title": "Coverage limit requested",
        "minimum": 0
      },
      "deductible": {
        "type": "number",
        "title": "Deductible",
        "minimum": 0
      },
      "special_requirements": {
        "type": "string",
        "title": "Special coverage requirements"
      },
      "exclusions": {
        "type": "string",
        "title": "Exclusions or limitations requested"
      },
      "temporary_structures": {
        "type": "boolean",
        "title": "Temporary structures on site?"
      },
      "hazardous_materials": {
        "type": "boolean",
        "title": "Hazardous materials on site?"
      },
      "site_security": {
        "type": "string",
        "title": "Site access and security measures"
      },
      "adjacent_concerns": {
        "type": "string",
        "title": "Adjacent property concerns"
      },
      "additional_risk_factors": {
        "type": "string",
        "title": "Additional risk factors"
      },
      "base_rate": {
        "type": "number",
        "title": "Base rate per $100 TIV"
      },
      "base_premium": {
        "type": "number",
        "title": "Base premium"
      },
      "duration_modifier": {
        "type": "number",
        "title": "Duration modifier"
      },
      "construction_modifier": {
        "type": "number",
        "title": "Construction modifier"
      },
      "experience_modifier": {
        "type": "number",
        "title": "Experience modifier"
      },
      "location_modifier": {
        "type": "number",
        "title": "Location modifier"
      },
      "total_premium": {
        "type": "number",
        "title": "TOTAL PREMIUM"
      },
      "quote_document_key": {
        "type": "string",
        "title": "Quote document (object-store key)"
      },
      "linked_policy_id": {
        "type": "string",
        "title": "Resulting policy record id"
      },
      "renewal_of_policy_id": {
        "type": "string",
        "title": "Renewal of policy record id"
      }
    },
    "required": [
      "status",
      "client_id",
      "insured_name",
      "insured_address",
      "project_name",
      "project_type",
      "project_address",
      "tiv"
    ]
  },
