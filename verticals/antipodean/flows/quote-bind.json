          "id": "ASSERT_TOPICS",
          "node_type": "eval",
          "payload": {
            "code": "(function () {\n  // =========================================================================\n  // ASSERT-1b (contract artefact 5) — runtime, on every bind, after the four\n  // schedule calls and BEFORE the stamp: the four returned topics are four\n  // distinct non-empty strings. This is the cheapest assertion in the contract\n  // and the one that matters: it catches a name or subject collision at the\n  // BIND, not at the first void sixty-one days later.\n  // =========================================================================\n  function topicOf(resp) {\n    if (!resp || typeof resp !== 'object') return '';\n    if (typeof resp.topic === 'string') return resp.topic;\n    if (resp.data && typeof resp.data.topic === 'string') return resp.data.topic;\n    if (resp.results && resp.results.length && resp.results[0].topic) return resp.results[0].topic;\n    return '';\n  }\n  var t = {\n    invoice_overdue_timer_topic: topicOf(sOverdue),\n    policy_void_timer_topic: topicOf(sVoid),\n    renewal_generate_timer_topic: skipRenewal ? '' : topicOf(sRenew),\n    renewal_dispatch_timer_topic: skipRenewal ? '' : topicOf(sDispatch)\n  };\n  var required = ['invoice_overdue_timer_topic', 'policy_void_timer_topic'];\n  if (!skipRenewal) { required.push('renewal_generate_timer_topic'); required.push('renewal_dispatch_timer_topic'); }\n\n  var live = [];\n  for (var i = 0; i < required.length; i++) {\n    var v = t[required[i]];\n    if (!v) {\n      // Fail the run. Artefact 5: do not compensate, do not retry in-node, do\n      // not compute the topic locally as a substitute. A policy that does not\n      // carry its topics can never have its timers cancelled.\n      throw new Error('ASSERT-1b FAILED: ' + required[i] + ' is empty — a timer was scheduled that nothing can ever cancel');\n    }\n    live.push(v);\n  }\n  var uniq = {};\n  for (var j = 0; j < live.length; j++) {\n    if (uniq[live[j]]) throw new Error('ASSERT-1b FAILED: two concerns returned the same topic ' + live[j] + ' — a name or target-flow collision, and one policy has silently lost a timer (MaxMsgsPer: 1)');\n    uniq[live[j]] = 1;\n  }\n  t.timers_scheduled = 'scheduled';\n  t.distinct_topics = live.length;\n  t.renewal_timers_skipped = !!skipRenewal;\n  t.names_used = names;\n  return t;\n})();\n",
            "params": {
