      {
        "id": "TIMER_NAMES",
        "data": {
          "id": "TIMER_NAMES",
          "node_type": "eval",
          "payload": {
            "code": "(function () {\n  // =========================================================================\n  // TIMER_NAMES — contract artefact 5. This is the ONE place in the build where\n  // the name format \"<concern>:<entityId>\" is spelled. Every other flow that\n  // schedules, cancels or reschedules one of these timers composes its name\n  // from the same registry, never from a literal it wrote itself.\n  //\n  //   name  = \"<concern>:<policyId>\"      <- sent as ScheduleFlowRun.name\n  //   topic = \"<flowTopic>.<fnv1a32(name)>\"  <- DERIVED by the engine and\n  //           returned; the caller's own `topic` is overwritten unconditionally\n  //           (schedule.go:113-118) and it is the ONLY thing unschedule accepts.\n  //\n  // <policyId> is the RECORD ID returned by CREATE_POLICY, never policy_number:\n  // records enforce no uniqueness, so two policies can carry one number and\n  // one number is one timer, silently, under MaxMsgsPer: 1.\n  // =========================================================================\n  var policyId = (pol && pol.id) ? String(pol.id) : '';\n  if (!policyId) { throw new Error('TIMER_NAMES: CREATE_POLICY returned no record id; refusing to compose a timer name'); }\n  if (policyId.indexOf(':') >= 0 || policyId.indexOf('@') >= 0 || policyId.indexOf('.') >= 0) {\n    throw new Error('TIMER_NAMES: record id ' + policyId + ' carries a delimiter that breaks positional subject parsing');\n  }\n  var out = { policy_id: policyId, concerns: concerns.slice(), names: {} };\n  for (var i = 0; i < concerns.length; i++) {\n    out.names[concerns[i]] = concerns[i] + ':' + policyId;\n  }\n  out.name_invoice_overdue = out.names['invoice-overdue'];\n  out.name_policy_void = out.names['policy-void'];\n  out.name_renewal_generate = out.names['renewal-generate'];\n  out.name_renewal_dispatch = out.names['renewal-dispatch'];\n\n  // ASSERT-1c: the concern tokens are pairwise distinct and drawn only from the\n  // registry in config.static.\n  var seen = {};\n  for (var j = 0; j < concerns.length; j++) {\n    if (seen[concerns[j]]) throw new Error('TIMER_NAMES: duplicate concern token ' + concerns[j]);\n    seen[concerns[j]] = 1;\n  }\n  if (concerns.length !== 4) throw new Error('TIMER_NAMES: expected 4 bind-time concerns, got ' + concerns.length);\n\n  out.on_invoice_overdue = b.on_invoice_overdue;\n  out.on_policy_void = b.on_policy_void;\n  out.on_renewal_generate = b.on_renewal_generate;\n  out.on_renewal_dispatch = b.on_renewal_dispatch;\n  // Artefact 5, \"Past trigger_on\": do NOT call schedule-flow; stamp the empty\n  // string and continue. A policy whose term is under 100 days produces a T-100\n  // that has already passed.\n  out.renewal_timers_in_past = !!b.renewal_timers_in_past;\n  return out;\n})();\n",
            "params": {
              "pol": "$.CREATE_POLICY.data",
              "b": "$.BIND_INPUTS",
              "concerns": "$.static.timer_concerns"
            }
          },
          "name": "Timer names (artefact 5)"
        }
      },
