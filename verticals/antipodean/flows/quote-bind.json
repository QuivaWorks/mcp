              "sDispatch": "$.SCHEDULE_DISPATCH",
              "skipRenewal": "$.TIMER_NAMES.renewal_timers_in_past",
              "names": "$.TIMER_NAMES.names"
            }
          },
          "name": "ASSERT-1b: four distinct topics"
