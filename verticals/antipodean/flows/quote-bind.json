        }
      },
      {
        "id": "SANCTIONS_SCREEN",
        "data": {
          "id": "SANCTIONS_SCREEN",
          "node_type": "eval",
          "payload": {
            "code": "(function () {\n  // SANCTIONS SCREEN. No sanctions provider is configured for this account and\n  // none is named in the spec beyond §4.4's requirement that the check runs on\n  // the TRADING NAME, which §6.1's ABR call (SearchByABNv202001) does not\n  // return. So this is a deterministic local screen against a denylist held in\n  // config.static, and it is DELIBERATELY NOT an http node: an http node with\n  // options.attempts > 1 fails OPEN, and on the bind flow that is a sanctions\n  // outage becoming a bound policy (§9). Replacing this with a real provider is\n  // a change to this node plus a static list, and nothing else.\n  var name = String(subjectName || '').toUpperCase();\n  var hits = [];\n  for (var i = 0; i < denylist.length; i++) {\n    var entry = String(denylist[i] || '').toUpperCase();\n    if (entry && name.indexOf(entry) >= 0) hits.push(denylist[i]);\n  }\n  if (!name) {\n    return { state: 'hit', reason: 'NO_NAME_TO_SCREEN', matches: [], provider: providerName };\n  }\n  return {\n    state: hits.length ? 'hit' : 'clear',\n    reason: hits.length ? 'DENYLIST_MATCH' : 'NO_MATCH',\n    matches: hits,\n    provider: providerName,\n    screened_at: new Date().toISOString().replace(/\\.\\d{3}Z$/, 'Z')\n  };\n})();\n",
            "params": {
              "subjectName": "$.BIND_INPUTS.screening_name",
              "denylist": "$.static.sanctions_denylist",
              "providerName": "$.static.sanctions_provider"
            }
          },
          "name": "Sanctions screen"
        }
      },
      {
        "id": "BIND_GATE",
        "data": {
          "id": "BIND_GATE",
          "node_type": "condition",
          "payload": [
            {
              "condition": {
                "operator": ">",
                "input": [
                  "$.CHECK_EXISTING_POLICY.data.total_hits",
                  0
                ]
              },
              "outcome": "RETURN_EXISTING"
            },
            {
              "condition": {
                "operator": "!=",
                "input": [
                  "$.BIND_INPUTS.outcome",
                  "ACCEPT"
                ]
              },
              "outcome": "REFUSE_NOT_ACCEPTED"
            },
