{
  "name": "quote-bind",
  "description": "Flow 2. Sanctions screen, idempotency gate, create policy + invoice, schedule the four per-entity timers under contract artefact 5's <concern>:<policyId> names, assert four distinct returned topics, stamp them on the policy, stamp BOUND, send the welcome pack.",
  "config": {
    "static": {
      "api": "https://api.microstrate.io",
      "space_id": "ANTIPODEAN",
      "timer_concerns": [
        "invoice-overdue",
        "policy-void",
        "renewal-generate",
        "renewal-dispatch"
      ],
      "timer_flow_subjects": {
        "invoice-overdue": "ms.hub.config.workflow.3788449144.2948463293",
        "policy-void": "ms.hub.config.workflow.3788449144.950582440",
        "renewal-generate": "ms.hub.config.workflow.3788449144.754421245",
        "renewal-dispatch": "ms.hub.config.workflow.3788449144.1497961748"
      },
      "term_days": 365,
      "invoice_overdue_days": 46,
      "void_after_days": 61,
      "sanctions_provider": "none-configured (local denylist screen — see SANCTIONS_SCREEN)",
      "sanctions_denylist": [
        "OFAC TEST ENTITY",
        "SANCTIONED HOLDINGS",
        "BLOCKED PERSON PTY LTD"
      ],
      "email_from_name": "Antipodean Underwriting"
    },
    "result": "$.BIND_INPUTS",
    "nodes": [
      {
        "id": "TRIGGER_BIND",
        "data": {
          "id": "TRIGGER_BIND",
          "node_type": "trigger",
          "payload": {},
          "name": "Bind requested (gateway)"
        }
      },
      {
        "id": "LOAD_DECISION",
        "data": {
          "id": "LOAD_DECISION",
          "node_type": "http",
          "payload": {
            "url": "https://api.microstrate.io/records/decision_config/|$.trigger.decision_id",
            "method": "GET",
            "headers": {
              "Authorization": "Bearer |$.env.auth_token",
              "Content-Type": "application/json"
            }
          },
          "name": "Load decision"
        }
      },
      {
        "id": "BIND_INPUTS",
        "data": {
          "id": "BIND_INPUTS",
          "node_type": "eval",
          "payload": {
            "code": "(function () {\n  var rec = (dec && dec.data) ? dec.data : {};\n  var id = (dec && dec.id) ? dec.id : '';\n  var now = new Date();\n  function iso(d) { return d.toISOString().replace(/\\.\\d{3}Z$/, 'Z'); }\n  function day(d) { return d.toISOString().slice(0, 10); }\n  function addDays(d, n) { return new Date(d.getTime() + n * 86400000); }\n\n  var year = now.getUTCFullYear();\n  var product = String(rec.product_code || 'GEN').toUpperCase().replace(/[^A-Z0-9]/g, '');\n  var quoteId = String(rec.quote_id || '');\n\n  var inception = trg && trg.inception_date ? new Date(trg.inception_date) : now;\n  if (isNaN(inception.getTime())) inception = now;\n  var termDays = Number(termDaysCfg) || 365;\n  var expiration = addDays(inception, termDays);\n\n  return {\n    decision_id: id,\n    quote_id: quoteId,\n    submission_id: String(rec.submission_id || ''),\n    product_code: product,\n    broker_id: String(rec.broker_id || (trg && trg.broker_id) || ''),\n    distributor_account_id: String(rec.distributor_account_id || ''),\n    outcome: String(rec.outcome || ''),\n    premium_basis: String(rec.premium_basis || ''),\n    base_premium: Number(rec.base_premium || 0),\n    total_payable: Number(rec.total_payable || 0),\n    // §5.4: counter names cannot contain hyphens\n    // (numbergen-service/validate/validate.go:9). Per-year counters mean no\n    // annual reset is ever needed.\n    policy_counter_name: 'P_' + product + '_' + year,\n    invoice_counter_name: 'I_' + product + '_' + year,\n    // §5.4 idempotency: records enforce no uniqueness, so a duplicate bind must\n    // be caught before the counter is touched, never after.\n    policy_filter: JSON.stringify([{ field: 'quote_id', keyword: quoteId }]),\n    bind_date: iso(now),\n    bind_day: day(now),\n    inception_date: iso(inception),\n    expiration_date: iso(expiration),\n    issue_date: iso(now),\n    due_date: iso(addDays(now, 45)),\n    void_deadline: iso(addDays(now, 60)),\n    void_after_days: Number(voidAfterDays) || 61,\n    void_due_date: iso(addDays(now, Number(voidAfterDays) || 61)),\n    // §4.4: neither entity stored a bind date; everything below is anchored on\n    // bind_date, which artefact 1 added to policy_config for exactly this.\n    on_invoice_overdue: iso(addDays(now, Number(overdueDays) || 46)),\n    on_policy_void: iso(addDays(now, Number(voidAfterDays) || 61)),\n    on_renewal_generate: iso(addDays(expiration, -100)),\n    on_renewal_dispatch: iso(addDays(expiration, -90)),\n    renewal_timers_in_past: (addDays(expiration, -100).getTime() <= now.getTime()) ||\n                            (addDays(expiration, -90).getTime() <= now.getTime()),\n    policyholder_name: String(rec.policyholder_name || (trg && trg.policyholder_name) || ''),\n    broker_email: String((trg && trg.broker_email) || ''),\n    // A '@' in a subject breaks consumer delivery and acks, and a dotted ref_id\n    // misroutes on positional subject parsing. Nothing user-typed reaches a\n    // subject token in this flow, but the screening name is sanitised anyway\n    // because it is the one free-text field the flow carries forward.\n    screening_name: String(rec.policyholder_name || (trg && trg.policyholder_name) || '')\n                      .replace(/[@.]/g, ' ').replace(/\\s+/g, ' ').trim()\n  };\n})();\n",
            "params": {
              "dec": "$.LOAD_DECISION.data",
              "trg": "$.trigger",
              "termDaysCfg": "$.static.term_days",
              "overdueDays": "$.static.invoice_overdue_days",
              "voidAfterDays": "$.static.void_after_days"
            }
          },
          "name": "Derive bind inputs"
