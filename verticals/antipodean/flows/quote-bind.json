      {
        "id": "FORMAT_REFS",
        "data": {
          "id": "FORMAT_REFS",
          "node_type": "eval",
          "payload": {
            "code": "(function () {\n  // §5.4: numbergen increment, then FORMAT in an eval. Counter names carry no\n  // hyphens; reference formats do — the sanitisation is consistent across both.\n  function n6(v) { return ('000000' + String(v)).slice(-6); }\n  function val(x) {\n    if (x === null || x === undefined) return 0;\n    if (typeof x === 'object') {\n      if (x.value !== undefined) return x.value;\n      if (x.count !== undefined) return x.count;\n      if (x.data && x.data.value !== undefined) return x.data.value;\n    }\n    return x;\n  }\n  var p = Number(val(pnum)), i = Number(val(inum));\n  if (!p || isNaN(p)) throw new Error('FORMAT_REFS: policy counter returned no number');\n  if (!i || isNaN(i)) throw new Error('FORMAT_REFS: invoice counter returned no number');\n  var year = new Date(b.bind_date).getUTCFullYear();\n  return {\n    policy_number: 'P-' + b.product_code + '-' + year + '-' + n6(p),\n    invoice_number: 'INV-' + b.product_code + '-' + year + '-' + n6(i),\n    policy_seq: p, invoice_seq: i\n  };\n})();\n",
            "params": {
              "pnum": "$.MINT_POLICY_NUMBER",
              "inum": "$.MINT_INVOICE_NUMBER",
              "b": "$.BIND_INPUTS"
            }
          },
          "name": "Format references"
        }
