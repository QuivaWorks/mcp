# Copy to quiva-distribution-mcp/.env and fill in ONE auth option.
# .env is gitignored. Keep this template blank.
#
# Every call acts as the account the credential belongs to. Reads need root,
# admin, developer, monitoring or billing; writes need root or admin. A role
# that is too low answers 401, the same as a bad credential.

QUIVA_API_URL=https://api.quiva.ai

# Option 1: API key. A restricted key must allow the /accounts/distribution* routes.
QUIVA_API_KEY=

# Option 2: bearer token (JWT)
QUIVA_BEARER_TOKEN=

# Option 3: email + password (auto-login, re-login once on 401)
QUIVA_EMAIL=
QUIVA_PASSWORD=
QUIVA_ACCOUNT=

# Optional: path to a Node >= 18 binary if auto-detection fails
QUIVA_NODE=

# Optional, only for tools/harvest-examples.mjs: a distributor-side login.
QUIVA_DISTRIBUTOR_EMAIL=
QUIVA_DISTRIBUTOR_PASSWORD=
QUIVA_DISTRIBUTOR_ACCOUNT=
