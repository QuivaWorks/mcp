# Copy to quiva-agents-mcp/.env and fill in ONE of the auth options below.
# The .env file is gitignored — never commit real credentials.
#
# NOTE: an API key works on every agent endpoint — cerberus swaps X-Api-Key for
# a user JWT before hub-service sees the request. A restricted (msr-) key must
# be scoped to allow /hub/agent*, or it 401s at the gateway.

# API environment (default: production)
QUIVA_API_URL=https://api.quiva.ai

# --- Option 1: API key (must be scoped to allow /hub/agent* if restricted) ---
QUIVA_API_KEY=

# --- Option 2: bearer token (JWT) ---
QUIVA_BEARER_TOKEN=

# --- Option 3: email + password (auto-login with refresh) ---
QUIVA_EMAIL=
QUIVA_PASSWORD=
QUIVA_ACCOUNT=

# Optional: path to a Node >= 18 binary if auto-detection fails
QUIVA_NODE=
