# Copy to quiva-agents-mcp/.env and fill in ONE of the auth options below.
# The .env file is gitignored — never commit real credentials.
#
# IMPORTANT: hub-service derives the user/account from a Bearer JWT on EVERY
# agent endpoint (create/get/update/delete/invoke). An API key alone is
# resolved by the gateway but does NOT carry the JWT claims these handlers
# read — prefer the bearer token or email/password options below.

# API environment (default: staging)
QUIVA_API_URL=https://api.microstrate.io
# Production: https://api.quiva.ai

# --- Option 1: API key (gateway auth only — insufficient for most agent tools) ---
QUIVA_API_KEY=

# --- Option 2: bearer token (JWT) ---
QUIVA_BEARER_TOKEN=

# --- Option 3: email + password (auto-login with refresh) ---
QUIVA_EMAIL=
QUIVA_PASSWORD=
QUIVA_ACCOUNT=

# Optional: path to a Node >= 18 binary if auto-detection fails
QUIVA_NODE=
